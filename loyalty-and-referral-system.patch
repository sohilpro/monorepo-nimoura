diff --git a/scripts/create-unified-patch.cjs b/scripts/create-unified-patch.cjs
new file mode 100644
--- /dev/null
+++ b/scripts/create-unified-patch.cjs
@@ -0,0 +1,58 @@
+const { execSync } = require("child_process");
+const fs = require("fs");
+const path = require("path");
+
+const trackedDiff = execSync("git diff", { encoding: "utf8" });
+
+function getAllFiles(dirPath, arrayOfFiles = []) {
+  const files = fs.readdirSync(dirPath);
+  for (const file of files) {
+    const fullPath = path.join(dirPath, file);
+    if (fs.statSync(fullPath).isDirectory()) {
+      getAllFiles(fullPath, arrayOfFiles);
+    } else {
+      arrayOfFiles.push(fullPath.replace(/\\/g, "/"));
+    }
+  }
+  return arrayOfFiles;
+}
+
+const statusOutput = execSync("git status -s", { encoding: "utf8" });
+const untrackedFiles = [];
+for (const line of statusOutput.split("\n")) {
+  if (line.startsWith("?? ")) {
+    const item = line.slice(3).trim();
+    if (item.endsWith(".patch")) continue;
+    if (fs.existsSync(item)) {
+      if (fs.statSync(item).isDirectory()) {
+        getAllFiles(item, untrackedFiles);
+      } else {
+        untrackedFiles.push(item.replace(/\\/g, "/"));
+      }
+    }
+  }
+}
+
+let fullPatch = trackedDiff;
+
+for (const relPath of untrackedFiles) {
+  if (!fs.existsSync(relPath)) continue;
+  const content = fs.readFileSync(relPath, "utf8");
+  const lines = content.split("\n");
+  const lineCount = lines.length;
+  const posixPath = relPath.replace(/\\/g, "/");
+  
+  fullPatch += `\ndiff --git a/${posixPath} b/${posixPath}\n`;
+  fullPatch += `new file mode 100644\n`;
+  fullPatch += `--- /dev/null\n`;
+  fullPatch += `+++ b/${posixPath}\n`;
+  fullPatch += `@@ -0,0 +1,${lineCount} @@\n`;
+  for (const line of lines) {
+    fullPatch += `+${line}\n`;
+  }
+}
+
+fs.writeFileSync("loyalty-and-referral-system.patch", fullPatch, "utf8");
+fs.writeFileSync("loyalty-complete-fix.patch", fullPatch, "utf8");
+console.log("Patches written successfully. Length:", fullPatch.length);
+
