+              <span class="max-w-[160px] truncate">{{ att.name }}</span>
+              <button
+                type="button"
+                class="text-gray-400 hover:text-rose-500 transition-colors cursor-pointer"
+                @click="removeAttachment(idx)"
+              >
+                <i class="pi pi-times text-[10px]" />
+              </button>
