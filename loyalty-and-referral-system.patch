+    </div>
+
+    <template #footer>
+      <div class="flex justify-end gap-2 pt-2">
+        <Button
+          type="button"
+          label="انصراف"
+          class="p-button-text p-button-sm text-gray-600"
+          :disabled="submitting"
+          @click="visible = false"
+        />
+        <Button
+          type="button"
+          label="ثبت درخواست تسویه"
+          icon="pi pi-check"
+          class="p-button-sm !bg-nimoura-primary !border-nimoura-primary text-white"
+          :loading="submitting"
+          @click="handleSubmit"
+        />
+      </div>
+    </template>
