+            <i v-else class="pi pi-paperclip text-sm" />
+            <span>{{ uploading ? 'در حال بارگذاری فایل...' : 'انتخاب تصویر یا فایل (حداکثر ۱۰ مگابایت)' }}</span>
+            <input
+              type="file"
