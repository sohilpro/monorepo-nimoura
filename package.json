{
  "name": "nimoura-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:turbo": "turbo run dev",
    "dev:api": "npm run dev --workspace=@nimoura/api",
    "dev:web": "npm run dev --workspace=@nimoura/web",
    "dev:admin": "npm run dev --workspace=@nimoura/admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.4.4"
  },
  "packageManager": "npm@10.8.2"
}
